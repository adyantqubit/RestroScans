# Copy this file to backend/.env and fill in this machine's values.
# A blank value uses the default shown in the comment. Restart Django after a change.
# Required in production means the app refuses to start when DEBUG=False and the value is blank.

# --- Django ---

# Signs sessions and CSRF tokens. Required in production. Example: a long random string
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# True prints detailed errors and allows OTP codes in API responses. False is production. Example: True
DEBUG=True

# Hosts Django will answer. * allows every host (local only). Example: .restroscans.com,restroscans.com
ALLOWED_HOSTS=*

# Time used for orders, OTP expiry and reports. Example: Asia/Kolkata
TIME_ZONE=Asia/Kolkata

# Optional. Log verbosity. Blank uses DEBUG when DEBUG=True, otherwise INFO. Example: INFO
LOG_LEVEL=

# Optional. Folder for django_logs.log and custom_logs.log. Blank uses backend/logs. Example: D:\logs\restroscans
LOG_DIR=

# --- PostgreSQL ---

# Database name. Create this database before migrating. Example: restroscans
DB_NAME=restroscans

# Database user. Example: postgres
DB_USER=postgres

# Database password. Example: admin
DB_PASSWORD=your-database-password

# Database host. Example: localhost
DB_HOST=localhost

# Database port. Example: 5432
DB_PORT=5432

# Optional. Seconds a database connection is reused. 0 opens a new one per request (fine locally). Example: 60
DB_CONN_MAX_AGE=0

# --- Local addresses (hosts file points these names at this machine) ---
# Customer menu:  http://<tenant>.restroscans.com:3000     (frontend, npm run dev)
# Staff panel:    http://<tenant>.restroscans.com:3001/admin   (admin_panel, npm start)
# Django admin:   http://<tenant>.restroscans.com:8000/django-admin
# Create restaurants (public schema): http://restroscans.com:8000/django-admin

# --- Tenant routing / URLs ---

# Scheme written in front of generated links. Use https:// in production. Example: http://
HTTP_METHOD=http://

# Root domain of restaurant sites (<tenant>.<domain>). Example: restroscans.com
BASE_DOMAIN=restroscans.com

# Path segment of the public auth endpoints: /admin_app/<this>/login/. Must match REACT_APP_AUTH_PATH. Example: restroscans
DOMAIN_NAME=restroscans

# Optional. Menu URL stored on each restaurant (QR codes). {tenant} is the restaurant name.
# Blank uses <HTTP_METHOD>{tenant}.<BASE_DOMAIN>/. Local example: http://{tenant}.restroscans.com:3000/
TENANT_SITE_URL_TEMPLATE=http://{tenant}.restroscans.com:3000/

# Optional. Browser-reachable API of a restaurant. {domain} is the tenant domain.
# Blank uses <HTTP_METHOD>{domain}:8000. Production example: https://{domain}
TENANT_API_URL_TEMPLATE=http://{domain}:8000

# Optional. Seconds a restaurant lookup is cached in each process. 0 turns the cache off. Example: 30
TENANT_CACHE_SECONDS=30

# --- CORS / CSRF / HTTPS ---

# True lets any site call the API. Keep True locally; False in production, then list origins below. Example: True
CORS_ALLOW_ALL_ORIGINS=True

# Send cookies on cross-origin requests. Example: True
CORS_ALLOW_CREDENTIALS=True

# Optional when CORS_ALLOW_ALL_ORIGINS=True. Comma-separated browser origins.
# Customer site is port 3000. Staff panel is port 3001.
# Example: http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional. Regexes for extra origins, such as every restaurant subdomain.
# Blank allows http and https for BASE_DOMAIN and its subdomains. Example: ^https://([a-z0-9-]+\.)?restroscans\.com$
CORS_ALLOWED_ORIGIN_REGEXES=

# Optional. Hosts allowed to POST Django admin forms. Needed behind https. Example: .restroscans.com
CSRF_TRUSTED_ORIGINS=

# Optional. Mark session and CSRF cookies Secure. Blank follows HTTP_METHOD (true only for https://). Example: False
SECURE_COOKIES=

# Optional. Trust X-Forwarded-Proto from a reverse proxy. Blank follows HTTP_METHOD. Example: False
USE_X_FORWARDED_PROTO=

# Redirect every request to https. Keep False locally. Example: False
SECURE_SSL_REDIRECT=False

# --- Static / media ---

# URL prefix for collected static files. Example: /staticfiles/
STATIC_URL=/staticfiles/

# Optional. Folder `collectstatic` writes to. Blank uses backend/admin_app/static. Example: D:\work\RestroScans\backend\staticfiles
STATIC_ROOT=

# URL prefix for uploaded images. Example: media/
MEDIA_URL=media/

# Optional. Folder uploads are stored in. Blank uses backend/media. Example: D:\work\RestroScans\backend\media
MEDIA_ROOT=

# Django serves /media/ itself. Set False when nginx serves that folder. Example: True
SERVE_MEDIA_FILES=True

# --- Auth tokens ---

# Signs staff access tokens. Required in production. Example: a long random string
JWT_ACCESS_SECRET=change-me-access

# Signs staff refresh tokens. Required in production. Example: a different long random string
JWT_REFRESH_SECRET=change-me-refresh

# Optional. Hours an access token stays valid. The admin panel renews it from the refresh token. Example: 2
JWT_ACCESS_HOURS=2

# Optional. Days a refresh token stays valid. Example: 7
JWT_REFRESH_DAYS=7

# Optional. Fernet key, only to read waiter passwords saved by older versions. Blank skips that. Example: a 32-byte url-safe base64 key
ENCRYPT_KEY=

# --- Email / SMTP ---

# Optional. SMTP server. Blank uses smtp.gmail.com. With no EMAIL_HOST_USER, mail is printed in the Django terminal. Example: smtp.gmail.com
EMAIL_HOST=smtp.gmail.com

# Optional. SMTP port. 587 with TLS, 465 with SSL. Example: 587
EMAIL_PORT=587

# Optional. Use STARTTLS. Example: True
EMAIL_USE_TLS=True

# Optional. Use implicit SSL. Do not turn this on together with EMAIL_USE_TLS. Example: False
EMAIL_USE_SSL=False

# Optional. SMTP username. Blank prints emails to the console instead of sending them. Example: owner@gmail.com
EMAIL_HOST_USER=

# Optional. SMTP password or Gmail app password. Example: a 16-character app password
EMAIL_HOST_PASSWORD=

# Optional. Seconds to wait for the SMTP server. Example: 15
EMAIL_TIMEOUT=15

# Optional. Django email backend class. Blank picks SMTP when EMAIL_HOST_USER is set, otherwise the console. Example: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=

# Optional. From address. Blank uses EMAIL_HOST_USER, or no-reply@<BASE_DOMAIN>. Example: no-reply@restroscans.com
DEFAULT_FROM_EMAIL=

# --- Customer OTP ---
# The customer site sends the order SMS with Firebase phone sign-in. Set FIREBASE_PROJECT_ID
# to that same Firebase project. SMS_PROVIDER is not used for customer orders.

# Unused by the customer order OTP. Left for a future SMS vendor. Example: console
SMS_PROVIDER=console

# Optional. Required only when SMS_PROVIDER=http. Example: https://sms.example.com/send
SMS_API_URL=

# Optional. Sent with the SMS request when SMS_PROVIDER=http. Example: your-sms-api-key
SMS_API_KEY=

# Optional. Digits in an OTP. Example: 6
OTP_LENGTH=6

# Optional. Minutes before an unused OTP expires. Example: 5
OTP_EXPIRY_MINUTES=5

# Optional. Most OTPs one phone can request in the window. Example: 5
OTP_MAX_SENDS=5

# Optional. Wrong guesses allowed before the code is locked. Example: 5
OTP_MAX_ATTEMPTS=5

# Optional. Seconds before the same phone can ask for another code. Example: 30
OTP_RESEND_SECONDS=30

# Optional. Minutes a verified phone may place orders. Example: 20
OTP_TOKEN_MINUTES=20

# Optional. Extra hours that phone may still view and update its own order. Example: 12
ORDER_ACCESS_GRACE_HOURS=12

# Require the order token on customer order pages. False lets anyone who knows an order number read it. Example: True
ORDER_ACCESS_ENFORCED=True

# Optional. Seconds a live-order WebSocket ticket can be used. Example: 60
WS_TICKET_SECONDS=60

# --- Firebase push notifications ---

# Optional. Legacy FCM server key. Blank disables that sender. Example: AAAA...
FCM_SERVER_KEY=

# Optional. Path to the Firebase service-account JSON used for push. Blank uses backend/backend/credentials.json. Example: D:\secrets\firebase.json
FIREBASE_CREDENTIALS_FILE=

# Firebase project id that sends the customer order OTP. Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID. Example: restroscans-test
FIREBASE_PROJECT_ID=

# --- Real-time ---

# Optional. Redis URL so live order updates work across more than one Django process. Blank uses memory, which is enough for one local server. Example: redis://127.0.0.1:6379/0
REDIS_URL=
