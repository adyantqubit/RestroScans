# Customer site - production build. Public values only. Never put secrets here.
# Production menu: https://<tenant>.restroscans.com/
# Staff panel: https://<tenant>.restroscans.com/admin
# Django admin: https://restroscans.com/django-admin
# Next.js compiles NEXT_PUBLIC_* into the browser bundle at `npm run build`. Rebuild after a change.

# Django API that next.config.js forwards /api and /media to, from the Next.js server. Example: http://127.0.0.1:8000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Root domain. <tenant>.restroscans.com selects the restaurant. Example: restroscans.com
NEXT_PUBLIC_BASE_DOMAIN=restroscans.com

# Optional. WebSocket origin for live order updates. Blank opens the socket on the page's own host, which a proxy should forward to Django. Example: wss://restroscans.com
NEXT_PUBLIC_WS_ORIGIN=

# Optional. Milliseconds before an API call is given up. Blank uses 30000. Example: 30000
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# --- Firebase web push. Optional as a group: leave all of these blank to disable push notifications. ---

# Web API key from the Firebase console (Project settings). Example: AIzaSy...
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAIcy2oKuVW11_0gmv-6mYnCsQCwiop6Qg

# Auth domain of the Firebase project. Example: my-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firstfcmmessagingproject.firebaseapp.com

# Firebase project id. Example: my-project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=firstfcmmessagingproject

# Cloud Storage bucket. Example: my-project.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firstfcmmessagingproject.appspot.com

# Sender id (a numeric project number). Example: 553700732551
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=553700732551

# Web app id. Example: 1:553700732551:web:abc123
NEXT_PUBLIC_FIREBASE_APP_ID=1:553700732551:web:9474e08234630043a9d222

# Optional. Google Analytics measurement id. Blank skips Analytics. Example: G-S8QY4EZYBE
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-S8QY4EZYBE

# Optional. VAPID key from Firebase Cloud Messaging, needed to subscribe this browser to push. Example: BFbm...
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BFBMZXfht5P5mlZ_MtL4OER7W1iZojCTNYgVAUe83trFjy4yIjLVAuxJ_IIGVlNkks9SNveg78G_GKiQBTOtnmk
