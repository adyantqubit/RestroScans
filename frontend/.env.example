# Copy to frontend/.env.local for development. Production values live in .env.production.
# Every NEXT_PUBLIC_ value is public: Next.js compiles it into the browser bundle. Never put secrets here.
# Restart `npm run dev` after a change. The dev server listens on port 3000 (see package.json).
# Customer menu: http://<tenant>.restroscans.com:3000/
# Staff panel is a different app: http://<tenant>.restroscans.com:3001/admin
# Django admin is http://restroscans.com:8000/django-admin

# Django API that next.config.js forwards /api and /media to. Use the LAN address so it works whether Django was started on 192.168.1.4:8000 or 0.0.0.0:8000. Example: http://192.168.1.4:8000
NEXT_PUBLIC_API_ORIGIN=http://192.168.1.4:8000

# Root domain. The restaurant is the subdomain in front of this (<tenant>.localhost works locally). Example: restroscans.com
NEXT_PUBLIC_BASE_DOMAIN=restroscans.com

# Optional. WebSocket origin for live order updates. The Next dev server does not proxy WebSockets, so point this at Django locally.
# Blank uses the page's own host (right in production, behind a proxy). Locally point this at the LAN address. Example: ws://192.168.1.4:8000
NEXT_PUBLIC_WS_ORIGIN=ws://192.168.1.4:8000

# Optional. Milliseconds before an API call is given up. Blank uses 30000. Example: 30000
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# --- Firebase. Order phone OTP uses this project. Web push also uses it when the VAPID key is set. ---
# Backend FIREBASE_PROJECT_ID must be the same project id.

# Web API key from the Firebase console (Project settings). Example: AIzaSy...
NEXT_PUBLIC_FIREBASE_API_KEY=

# Auth domain of the Firebase project. Example: my-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase project id. Example: my-project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Cloud Storage bucket. Example: my-project.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Sender id (a numeric project number). Example: 553700732551
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Web app id. Example: 1:553700732551:web:abc123
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Google Analytics measurement id. Blank skips Analytics. Example: G-S8QY4EZYBE
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. VAPID key from Firebase Cloud Messaging, needed to subscribe this browser to push. Example: BFbm...
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Country code added to the 10-digit contact number before Firebase sends the SMS. Example: 91
NEXT_PUBLIC_PHONE_COUNTRY_CODE=91
