# Admin panel - production build. Public values only. A .env.production.local file overrides this and is not committed.
# Staff panel: https://<tenant>.restroscans.com/admin
# Customer menu: https://<tenant>.restroscans.com/
# Django admin: https://restroscans.com/django-admin
# Create React App compiles these into the bundle at `npm run build`. Rebuild after a change.

# Optional. Django origin. Blank uses the page's own host, which is right when a proxy serves the panel and the API together. Example: https://api.restroscans.com
REACT_APP_API_ORIGIN=

# Optional. WebSocket origin for live order updates. Blank uses the page host. Example: wss://api.restroscans.com
REACT_APP_WS_ORIGIN=

# Optional. Milliseconds before an API call is given up. Blank uses 60000. Example: 60000
REACT_APP_API_TIMEOUT_MS=60000

# Root domain of restaurant sites (<tenant>.<domain>). Example: restroscans.com
REACT_APP_BASE_DOMAIN=restroscans.com

# Path segment of the auth endpoints. Must match DOMAIN_NAME in backend/.env. Example: restroscans
REACT_APP_AUTH_PATH=restroscans

# Menu URL encoded in each table QR code. {tenant} is the restaurant name. Example: https://{tenant}.restroscans.com/
REACT_APP_CUSTOMER_SITE_URL_TEMPLATE=https://{tenant}.restroscans.com/

# Keeps the runtime script in its own file so a strict Content-Security-Policy can allow it. Leave false. Example: false
INLINE_RUNTIME_CHUNK=false

# Staff panel URL path. The restaurant host serves this app at /admin. Example: /admin
PUBLIC_URL=/admin
