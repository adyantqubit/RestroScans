# Copy to admin_panel/.env.local for development. Production values live in .env.production.
# Every value here is public: Create React App compiles it into the browser bundle. Never put secrets here.
# Read at startup. Stop and run `npm start` again after a change.
# Staff panel: http://<tenant>.restroscans.com:3001/admin
# Customer menu: http://<tenant>.restroscans.com:3000
# Django admin: http://restroscans.com:8000/django-admin

# Django origin for API calls. Use the LAN address so it works whether Django was started on 192.168.1.4:8000 or 0.0.0.0:8000. Example: http://192.168.1.4:8000
# Optional in production, where the panel and the API share one host: leave it blank and the page's own origin is used.
REACT_APP_API_ORIGIN=http://192.168.1.4:8000

# Optional. WebSocket origin for live order updates. Blank derives it from REACT_APP_API_ORIGIN, then from the page host. Example: ws://192.168.1.4:8000
REACT_APP_WS_ORIGIN=

# Optional. Milliseconds before an API call is given up. Blank uses 60000. Example: 60000
REACT_APP_API_TIMEOUT_MS=60000

# Root domain of restaurant sites (<tenant>.<domain>), also printed on QR codes. Example: restroscans.com
REACT_APP_BASE_DOMAIN=restroscans.com

# Path segment of the auth endpoints: /admin_app/<this>/login/. Must match DOMAIN_NAME in backend/.env. Example: restroscans
REACT_APP_AUTH_PATH=restroscans

# Optional. Menu URL encoded in each table QR code. {tenant} is the restaurant name.
# Blank uses <page protocol>//{tenant}.<REACT_APP_BASE_DOMAIN>/. Should match TENANT_SITE_URL_TEMPLATE in backend/.env.
# Local example: http://{tenant}.restroscans.com:3000/
REACT_APP_CUSTOMER_SITE_URL_TEMPLATE=http://{tenant}.restroscans.com:3000/
REACT_APP_CUSTOMER_MENU_URL=http://{tenant}.restroscans.com:3000/menu-item

# Port `npm start` listens on. Open the panel at http://<tenant>.restroscans.com:3001/admin
PORT=3001

# Listen on the LAN address from the hosts file, not only 127.0.0.1.
HOST=0.0.0.0

# The restaurant host (tenant1.restroscans.com) is not localhost. Required for that host to load the dev server.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# The staff panel is served at /admin on this dev server.
PUBLIC_URL=/admin
